# Get the app bundle directory
APP_BUNDLE="$( cd "$( dirname "${BASH_SOURCE[0]}" )/../.." && pwd )"

# Project root is two levels up from app bundle
PROJECT_ROOT="$( cd "$APP_BUNDLE/.." && pwd )"

# Execute start.sh
exec "$PROJECT_ROOT/start.sh"
