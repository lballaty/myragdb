  "runPatterns": {
    "beforeCommit": {
      "description": "Run before committing changes",
      "tags": ["@smoke"],
      "duration": "5-10 minutes",
      "purpose": "Catch obvious breakage"
    },
    "beforePush": {
      "description": "Run before pushing to remote",
      "tags": ["@fast"],
      "duration": "20-30 minutes",
      "purpose": "Catch regressions early"
    },
    "beforePullRequest": {
      "description": "Run before creating pull request",
      "tags": ["all"],
      "duration": "60-120 minutes",
      "purpose": "Comprehensive testing"
    },
    "beforeRelease": {
      "description": "Run before deploying to production",
      "tags": ["all"],
      "duration": "60-120 minutes",
      "purpose": "Verify release readiness"
    },
    "nightly": {
      "description": "Automated nightly testing",
      "tags": ["all"],
      "duration": "60-120 minutes",
      "purpose": "Catch overnight regressions"
    },
    "ciPipeline": {
      "description": "Automated testing in CI/CD",
      "stages": {
        "onPush": {
          "tests": ["@smoke"],
          "duration": "5-10 minutes"
        },
        "onPullRequest": {
          "tests": ["@fast"],
          "duration": "20-30 minutes"
        },
        "beforeMerge": {
          "tests": ["all"],
          "duration": "60-120 minutes"
        }
      }
    }
  },
  "performanceTargets": {
    "apiResponseTime": {
      "searchRequest": "<300ms",
      "skillExecution": "<1000ms",
      "templateOperation": "<500ms",
      "directoryOperation": "<500ms"
    },
    "uiResponseTime": {
      "pageLoad": "<2s",
      "searchResultDisplay": "<1s",
      "navigationTransition": "<500ms"
    },
    "testExecutionTime": {
      "smokeTest": "<5s each",
      "fastTest": "<30s each",
      "fullSuite": "<120 minutes"
    }
  }
}
