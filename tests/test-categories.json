{
  "description": "Test categorization and metadata for MyRAGDB regression test suite",
  "categories": {
    "executionSpeed": {
      "@smoke": {
        "description": "Fast critical tests - should complete in <5 seconds",
        "duration": "5-10 minutes total",
        "purpose": "Verify critical paths work",
        "frequency": "After every code change"
      },
      "@fast": {
        "description": "Quick tests - should complete in <30 seconds each",
        "duration": "20-30 minutes total",
        "purpose": "Quick regression check",
        "frequency": "Before git push"
      },
      "@slow": {
        "description": "Long-running tests - >30 seconds each",
        "duration": "Variable (30+ minutes)",
        "purpose": "Comprehensive testing",
        "frequency": "Before release"
      }
    },
    "scope": {
      "@unit": {
        "description": "Single component tests",
        "isolates": "Individual component behavior",
        "mocking": "Mocked dependencies"
      },
      "@integration": {
        "description": "Multiple component interaction",
        "isolates": "Component interactions",
        "mocking": "Minimal mocking"
      },
      "@e2e": {
        "description": "Full system workflows",
        "isolates": "Complete system behavior",
        "mocking": "No mocking"
      },
      "@critical": {
        "description": "Must pass before release",
        "priority": "Highest",
        "mustPass": true
      }
    },
    "featureArea": {
      "@api": {
        "description": "Backend API tests",
        "tested": [
          "Search API",
          "Skill API",
          "Template API",
          "Directory API"
        ]
      },
      "@ui": {
        "description": "Frontend UI tests",
        "tested": [
          "Navigation",
          "Repository management",
          "Directory management",
          "Search interface",
          "Workflow builder"
        ]
      },
      "@search": {
        "description": "Search functionality",
        "tested": [
          "Keyword search (Meilisearch)",
          "Semantic search (ChromaDB)",
          "Hybrid search (combined)",
          "Search filters",
          "Result ranking"
        ]
      },
      "@workflow": {
        "description": "Workflow execution",
        "tested": [
          "Simple workflows",
          "Multi-step workflows",
          "Skill chaining",
          "Parameter handling"
        ]
      },
      "@indexing": {
        "description": "File indexing operations",
        "tested": [
          "Repository indexing",
          "Directory indexing",
          "Incremental updates",
          "Index performance"
        ]
      },
      "@repository": {
        "description": "Repository management",
        "tested": [
          "Repository discovery",
          "Enable/disable repos",
          "Repository statistics",
          "Nested repositories"
        ]
      },
      "@directory": {
        "description": "Directory management",
        "tested": [
          "Add directories",
          "Remove directories",
          "Directory indexing",
          "Directory statistics"
        ]
      },
      "@skill": {
        "description": "Skill execution",
        "tested": [
          "Skill listing",
          "Skill execution",
          "Parameter validation",
          "Result handling"
        ]
      },
      "@template": {
        "description": "Template operations",
        "tested": [
          "Template creation",
          "Template execution",
          "Template management",
          "Template versioning"
        ]
      },
      "@chat": {
        "description": "Chat interface and LLM configuration",
        "tested": [
          "Main dashboard tabs (Search, Activity, Repositories, Directories, Observability, LLM Manager)",
          "LLM provider configuration (Gemini, OpenAI, Anthropic)",
          "Chat interface (message input, send, display)",
          "Model selection and connection",
          "Token counting and context management",
          "Tool calling and function execution",
          "Message formatting (user, assistant, system)",
          "Clear chat and context compression",
          "Error handling and status display"
        ]
      },
      "@dashboard": {
        "description": "Main dashboard components",
        "tested": [
          "Tab navigation",
          "Repository management tab",
          "Directory management tab",
          "Activity monitoring tab",
          "Observability metrics tab",
          "LLM configuration tab",
          "Search functionality tab"
        ]
      },
      "@llm-manager": {
        "description": "LLM provider management",
        "tested": [
          "Google Gemini configuration",
          "OpenAI ChatGPT configuration",
          "Anthropic Claude configuration",
          "API key input and validation",
          "Model selection",
          "Connection testing",
          "Configuration persistence",
          "Error handling"
        ]
      },
      "@observability": {
        "description": "System observability and monitoring",
        "tested": [
          "Statistics display",
          "Database metrics",
          "Recent errors table",
          "Indexing events table",
          "Performance metrics",
          "Status indicators"
        ]
      },
      "@activity": {
        "description": "Activity monitoring and logging",
        "tested": [
          "UI activity logs",
          "Server logs",
          "Log filtering",
          "Log clearing",
          "Log export",
          "Real-time updates"
        ]
      }
    },
    "type": {
      "@smoke": {
        "description": "Smoke/sanity tests",
        "verifies": "Core functionality works",
        "priority": "Critical"
      },
      "@regression": {
        "description": "Regression prevention tests",
        "verifies": "Previously fixed bugs don't return",
        "priority": "High"
      },
      "@performance": {
        "description": "Performance benchmarks",
        "verifies": "Response times meet targets",
        "priority": "Medium"
      },
      "@compatibility": {
        "description": "Browser/OS compatibility",
        "verifies": "Works across browsers",
        "priority": "Medium"
      }
    }
  },
  "testSuites": {
    "smokeTests": {
      "name": "Smoke Tests",
      "tags": ["@smoke"],
      "duration": "5-10 minutes",
      "description": "Quick verification of critical functionality",
      "command": "npm test -- --grep '@smoke'",
      "frequency": "After every change"
    },
    "fastRegression": {
      "name": "Fast Regression",
      "tags": ["@fast"],
      "duration": "20-30 minutes",
      "description": "Quick full regression test",
      "command": "npm test -- --grep '@fast'",
      "frequency": "Before push"
    },
    "apiTests": {
      "name": "API Tests",
      "tags": ["@api"],
      "duration": "15-25 minutes",
      "description": "Backend API functionality",
      "command": "npm test -- --grep '@api'",
      "frequency": "For API changes"
    },
    "uiTests": {
      "name": "UI Tests",
      "tags": ["@ui"],
      "duration": "15-25 minutes",
      "description": "Frontend UI functionality",
      "command": "npm test -- --grep '@ui'",
      "frequency": "For UI changes"
    },
    "searchTests": {
      "name": "Search Tests",
      "tags": ["@search"],
      "duration": "20-30 minutes",
      "description": "Search functionality",
      "command": "npm test -- --grep '@search'",
      "frequency": "For search changes"
    },
    "integrationTests": {
      "name": "Integration Tests",
      "tags": ["@integration"],
      "duration": "30-45 minutes",
      "description": "Multi-component workflows",
      "command": "npm test -- --grep '@integration'",
      "frequency": "Before integration PRs"
    },
    "fullRegression": {
      "name": "Full Regression",
      "tags": ["all"],
      "duration": "60-120 minutes",
      "description": "Complete test suite",
      "command": "npm test",
      "frequency": "Before release"
    },
    "chatTests": {
      "name": "Chat Page Tests",
      "tags": ["@chat"],
      "duration": "25-35 minutes",
      "description": "Dashboard tabs and chat interface testing",
      "command": "npm test -- --grep '@chat'",
      "frequency": "For chat/LLM configuration changes"
    },
    "dashboardTests": {
      "name": "Dashboard Tests",
      "tags": ["@dashboard"],
      "duration": "20-30 minutes",
      "description": "Main dashboard tab and component testing",
      "command": "npm test -- --grep '@dashboard'",
      "frequency": "For dashboard UI changes"
    }
  },
